generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Parametro {
  id          Int      @id @default(autoincrement())
  tasaDolar   Decimal  @db.Decimal(12, 2)
  monedaLocal String   @default("BS")
}

model Proveedor {
  id        Int       @id @default(autoincrement())
  nombre    String
  ruc       String?
  telefono  String?
  email     String?
  direccion String?
  productos Producto[]
  compras   Compra[]
}

model Producto {
  id               Int      @id @default(autoincrement())
  codigo           String   @unique
  nombre           String
  descripcion      String?
  proveedorId      Int?
  proveedor        Proveedor? @relation(fields: [proveedorId], references: [id])
  moneda           String   @default("USD")
  costoUsd         Decimal  @db.Decimal(12, 2)
  costoLocal       Decimal  @db.Decimal(12, 2)
  precioVenta      Decimal  @db.Decimal(12, 2)
  precioVentaUsd   Decimal? @db.Decimal(12, 2)
  precioVentaFiado      Decimal? @db.Decimal(12, 2)
  precioVentaFiadoUsd   Decimal? @db.Decimal(12, 2)
  margenContado    Decimal? @db.Decimal(5, 2)
  margenFiado      Decimal? @db.Decimal(5, 2)
  stockActual      Decimal  @default(0) @db.Decimal(12, 2)
  stockMinimo      Decimal  @default(0) @db.Decimal(12, 2)
  activo           Boolean  @default(true)
  detalleCompras   DetalleCompra[]
  detalleVentas    DetalleVenta[]
  inventarioInicial InventarioInicial?
  movimientos      MovimientoInventario[]
  detalleConteos   DetalleConteo[]
}

model Compra {
  id             Int      @id @default(autoincrement())
  proveedorId    Int
  proveedor      Proveedor @relation(fields: [proveedorId], references: [id])
  fecha          DateTime @default(now())
  semana         String?
  numeroFactura  String?
  total          Decimal  @db.Decimal(12, 2)
  totalUsd       Decimal? @db.Decimal(12, 2)
  tasaDolar      Decimal? @db.Decimal(12, 2)
  tipoPago       String   @default("CONTADO") // CONTADO o CREDITO
  detalles       DetalleCompra[]
}

model DetalleCompra {
  id               Int      @id @default(autoincrement())
  compraId         Int
  compra           Compra   @relation(fields: [compraId], references: [id])
  productoId       Int
  producto         Producto @relation(fields: [productoId], references: [id])
  cantidad         Decimal  @db.Decimal(12, 2)  // total unidades
  cantidadBultos   Decimal? @db.Decimal(12, 2)  // número de bultos
  unidadesPorBulto Decimal? @db.Decimal(12, 2)  // unidades por bulto
  costoUsd         Decimal  @db.Decimal(12, 2)
  costoLocal       Decimal  @db.Decimal(12, 2)
}

model Venta {
  id           Int      @id @default(autoincrement())
  cliente      String?
  fecha        DateTime @default(now())
  total        Decimal  @db.Decimal(12, 2)
  metodoPago   String?
  pagado       Boolean  @default(false)
  detalles     DetalleVenta[]
}

model DetalleVenta {
  id            Int      @id @default(autoincrement())
  ventaId       Int
  venta         Venta    @relation(fields: [ventaId], references: [id])
  productoId    Int
  producto      Producto @relation(fields: [productoId], references: [id])
  cantidad      Decimal  @db.Decimal(12, 2)
  precioVenta   Decimal  @db.Decimal(12, 2)
  costoUnitario Decimal  @db.Decimal(12, 2)
}

model InventarioInicial {
  productoId    Int      @id
  producto      Producto @relation(fields: [productoId], references: [id])
  cantidad      Decimal  @db.Decimal(12, 2)
  costoUnitario Decimal  @db.Decimal(12, 2)
  fecha         DateTime @default(now())
}

model MovimientoInventario {
  id            Int      @id @default(autoincrement())
  productoId    Int
  producto      Producto @relation(fields: [productoId], references: [id])
  tipo          String
  cantidad      Decimal  @db.Decimal(12, 2)
  costoUnitario Decimal  @db.Decimal(12, 2)
  fecha         DateTime @default(now())
  referenciaId  Int?
}

model ConteoInventario {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @default(now())
  fechaInicio DateTime?
  fechaFin    DateTime?
  semana      String?
  usuario     String?
  estado      String   @default("ABIERTO")
  detalles    DetalleConteo[]
}

model DetalleConteo {
  id               Int      @id @default(autoincrement())
  conteoId         Int
  conteo           ConteoInventario @relation(fields: [conteoId], references: [id])
  productoId       Int
  producto         Producto @relation(fields: [productoId], references: [id])
  cantidadSistema  Decimal  @db.Decimal(12, 2)
  cantidadContada  Decimal  @db.Decimal(12, 2)
  diferencia       Decimal  @db.Decimal(12, 2)
}

model Usuario {
  id            Int      @id @default(autoincrement())
  nombre        String   @unique
  password      String
  rol           String   @default("VENDEDOR")
  activo        Boolean  @default(true)
  fechaCreacion DateTime @default(now())
}